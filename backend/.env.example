# --- core control plane ---------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=0.0.0.0:8080
# Host advertised to devices in the Connect panel (blank = request host).
PUBLIC_HOST=
# Base domain for tenant (workspace) subdomains, e.g. example.com -> factory1.example.com
TENANT_BASE_DOMAIN=

# Use a long random value in production. The core refuses to start in
# APP_ENV=production while JWT_SECRET/GATEWAY_TOKEN still hold these defaults
# (or are too short).
JWT_SECRET=change-me-in-production-please-32chars
JWT_TTL=72h

# CORS cross-origin allow-list (comma separated). Empty = dev reflect policy;
# in production, credentialed cross-origin requests require an explicit list.
# CORS_ALLOWED_ORIGINS=https://iot.example.com

# --- administration console (isolated from business users) ----------------
ADMIN_USERNAME=admin
# Leave empty to auto-generate a random password (logged once at startup).
ADMIN_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aiiot
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN=25
DB_MAX_IDLE=5

# Shared secret gateways present as X-Gateway-Token. Must match every gateway.
GATEWAY_TOKEN=change-me-gateway-token
GATEWAY_HEARTBEAT_TIMEOUT=90s

# --- NATS (mandatory uplink bus) -------------------------------------------
# Gateways publish device uplinks to this JetStream stream; the core consumes
# them. NATS is a required platform component, like PostgreSQL.
NATS_URL=nats://127.0.0.1:4222
# NATS_USER=
# NATS_PASSWORD=
# NATS_CREDS=/etc/aiiot/nats.creds   # alternative to user/password
NATS_STREAM=AIOT_UPLINK
NATS_UPLINK_SUBJECT=aiiot.uplink
NATS_DURABLE=core-uplink
NATS_QUEUE=core-uplink

DEVICE_OFFLINE_AFTER=5m

# --- OTA firmware ---------------------------------------------------------
OTA_DIR=./ota
# Externally reachable core URL used to build firmware download links.
OTA_PUBLIC_BASE_URL=http://127.0.0.1:8080
OTA_MAX_UPLOAD_MB=256

# --- Email notifications (optional) ---------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=secret
# SMTP_FROM=alerts@example.com

# Time-series storage tuning.
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_PARTITION_AHEAD=1
TELEMETRY_WRITE_BATCH_SIZE=512
TELEMETRY_FLUSH_INTERVAL=2s

# --- gateways (set in each gateway process) -------------------------------
# GATEWAY_CORE_URL=http://127.0.0.1:8080
# GATEWAY_TOKEN=change-me-gateway-token
# GATEWAY_INSTANCE_ID=mqtt-1
# GATEWAY_DOWNLINK_ADDR=0.0.0.0:9101
# Host/IP the core uses to reach this gateway (set to the public IP in prod).
# GATEWAY_ADVERTISE_HOST=127.0.0.1
# GATEWAY_HEARTBEAT=30s
# GATEWAY_AUTH_CACHE_TTL=5m

# MQTT gateway
# MQTT_TCP_ADDR=0.0.0.0:1883
# MQTT_WS_ADDR=0.0.0.0:8083
# MQTT_ENABLE_WS=false
# MQTT over TLS: the workspace/tenant is derived from the TLS SNI
# (factory1.example.com -> workspace factory1).
# MQTT_TLS_ADDR=0.0.0.0:8883
# MQTT_TLS_CERT=/etc/aiiot/tls/tls.crt
# MQTT_TLS_KEY=/etc/aiiot/tls/tls.key

# CoAP gateway
# COAP_UDP_ADDR=0.0.0.0:5683
# COAP_TCP_ADDR=

# Custom TCP gateway
# CUSTOM_TCP_ADDR=0.0.0.0:9000
